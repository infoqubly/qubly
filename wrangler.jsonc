{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qubly",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/about",
      "/about.html",
      "/about/",
      "/esterni",
      "/esterni.html",
      "/esterni/",
      "/interni",
      "/interni.html",
      "/interni/",
      "/paesaggi",
      "/paesaggi.html",
      "/paesaggi/",
      "/privacy-policy",
      "/privacy-policy.html",
      "/privacy-policy/",
      "/spazi",
      "/spazi.html",
      "/spazi/"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
